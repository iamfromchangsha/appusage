# ---- 构建产物 ----
native/bin/
native/obj/
dist/
*.user

# ---- 运行时数据（每人自己的用量记录，不该进仓库）----
data/
*.db
*.db-wal
*.db-shm
*.log

# ---- 含有 API Key / PAT 的本地配置（绝对不能提交）----
config.json
# 配置的备份 / 临时 / 恢复文件里同样有密钥，一个都不能漏
config.json.*
*.bak
*.tmp
secrets.json

# ---- Python 缓存 ----
__pycache__/
*.pyc

# ---- 工具缓存 ----
.playwright-cli/
.vs/
.vscode/
.idea/

# ---- 系统文件 ----
Thumbs.db
Desktop.ini
